# Shared bearer token used by the CRM to call this private worker.
# Railway recommendation: set this service variable to ${{shared.ROOFSCAN_API_TOKEN}}
ROOFSCAN_API_TOKEN=

# Enable real LiDAR processing for RoofScan Lab diagnostics.
ROOFSCAN_ENABLE_LIDAR_PROTOTYPE=true

# Optional cache path. Ephemeral is acceptable for initial launch.
ROOFSCAN_LIDAR_CACHE=/tmp/roofscan-lidar

# Overture release pin for reproducible footprint queries.
OVERTURE_RELEASE=2026-09-23.1
