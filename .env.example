# CW Roofing Pro production/runtime settings
GOOGLE_MAPS_API_KEY=

# Railway: use the RoofScan worker private domain + port.
# Recommended value:
# http://${{roofscan-worker.RAILWAY_PRIVATE_DOMAIN}}:8080
ROOFSCAN_WORKER_URL=

# Railway: reference the shared ROOFSCAN_API_TOKEN.
# Recommended value: ${{shared.ROOFSCAN_API_TOKEN}}
ROOFSCAN_WORKER_TOKEN=

# Persistent volume mount for production hosting
DATABASE_PATH=/data/data.db
UPLOADS_DIR=/data/uploads

# Optional commercial fallback provider
ARTEMIS_API_URL=
ARTEMIS_API_KEY=
